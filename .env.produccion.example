# Variables de PRODUCCIÓN. En el servidor: copiar como .env (junto a docker-compose.prod.yml),
# completar y proteger:  chmod 600 .env
# Nunca subir el .env real al repositorio.

# Dominio público de la app (con https). La API solo acepta peticiones de este origen.
CORS_ORIGIN=https://gestion.ejemplo.com

# --- Base de datos del bot (ya desplegada) ---
# Nombre de la red de Docker donde corre PostgreSQL:  docker network ls
RED_BD=
# Nombre del contenedor (o servicio) de PostgreSQL dentro de esa red:  docker ps
DB_HOST=
DB_PORT=5432
DB_NAME=ecofiltro_bot
DB_USER=eco_app
DB_PASSWORD=
DB_SSL=false
# Rol de SOLO LECTURA para el módulo de reportes (docs/sql/rol_eco_reportes.sql). Si se deja vacío,
# los reportes quedan desactivados (la API responde 503 en /api/reportes).
DB_REPORTES_USER=eco_reportes
DB_REPORTES_PASSWORD=
DB_POOL_MAX=10

# --- Sesión y login ---
SESION_TTL_HORAS=8
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
LOGIN_RATE_LIMIT_POR_MINUTO=10
LOG_LEVEL=info

# --- Publicación ---
# Puerto en 127.0.0.1 donde escucha la app; el proxy del servidor apunta aquí.
WEB_PUERTO=8080
# Proxies delante de la API: nginx del contenedor web + el proxy del servidor.
TRUST_PROXY_SALTOS=2

# --- Respaldos del esquema gestion (scripts/respaldar-gestion.sh) ---
RESPALDOS_DIR=./respaldos
RESPALDOS_DIAS=30
