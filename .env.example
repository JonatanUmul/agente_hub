# Copiar a .env y completar. Nunca subir .env al repositorio.

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
# Origen exacto de la web (CORS)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL. En desarrollo apunta al contenedor "db" de docker-compose.yml (puerto 5433 en localhost).
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ecofiltro_bot
DB_USER=eco_app
DB_PASSWORD=
DB_SSL=false
# Rol de SOLO LECTURA para el módulo de reportes (docs/sql/rol_eco_reportes.sql). Si se deja vacío,
# los reportes quedan desactivados (la API responde 503 en /api/reportes).
DB_REPORTES_USER=eco_reportes
DB_REPORTES_PASSWORD=
DB_POOL_MAX=10

# Sesión y login
# Secure exige HTTPS. Solo en desarrollo local (http://localhost) puede ser false; en producción la API no arranca si es false.
COOKIE_SECURE=true
SESION_TTL_HORAS=8
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
LOGIN_RATE_LIMIT_POR_MINUTO=10

# Superusuario del contenedor de desarrollo (solo lo usa Docker para inicializar la base).
DEV_PG_SUPERUSER=postgres
DEV_PG_SUPERPASSWORD=
