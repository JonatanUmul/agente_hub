# App corriendo EN TU MÁQUINA conectada a la base de PRODUCCIÓN por el túnel SSH (127.0.0.1:15433).
# Copiar como .env.produccion-tunel (git lo ignora) y completar usuario y contraseña.
# Se usa solo con los comandos *:produccion (npm run dev:api:produccion, migrar:produccion…).
# Las pruebas leen .env (base local) y NUNCA este archivo.
#
# ⚠ Lo que hagas en la app se aplica al bot de inmediato: son datos reales.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

DB_HOST=127.0.0.1
DB_PORT=15433
DB_NAME=ecofiltro_bot
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=5

SESION_TTL_HORAS=8
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
LOGIN_RATE_LIMIT_POR_MINUTO=10
